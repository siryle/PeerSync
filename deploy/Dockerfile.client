FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/peersync ./cmd/peersync

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/peersync /usr/local/bin/peersync
ENV PEERSYNC_HOME=/config \
    PEERSYNC_PATH=/sync \
    PEERSYNC_UI=0.0.0.0:8384
# The page listens on all interfaces. Set PEERSYNC_UI_TOKEN at run time.
VOLUME ["/config", "/sync"]
EXPOSE 42420/tcp 42420/udp 8384/tcp
ENTRYPOINT ["peersync"]
CMD ["serve"]
